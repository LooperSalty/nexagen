# ===========================================
# NEXAGEN — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# ---- Database ----
DATABASE_URL="postgresql://nexagen:nexagen@localhost:5432/nexagen?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- S3 / MinIO ----
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="nexagen"
S3_REGION="us-east-1"

# ---- Auth (Clerk) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ---- Stripe ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---- AI Services ----
TERRAIN_SERVICE_URL="http://localhost:5001"
CREATURE_SERVICE_URL="http://localhost:5002"
NARRATIVE_SERVICE_URL="http://localhost:5003"

# ---- Anthropic (Claude API for narrative) ----
ANTHROPIC_API_KEY=""

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
NODE_ENV="development"
